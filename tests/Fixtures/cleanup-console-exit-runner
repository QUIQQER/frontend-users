<?php

namespace QUI\System\Console {
    abstract class Tool
    {
        public function writeLn(
            string $msg = '',
            bool|string $color = false,
            bool|string $bg = false
        ): void {
        }
    }
}

namespace {
    require $argv[1];

    $Console = new class () extends \QUI\FrontendUsers\Cleanup\Console {
        public function __construct()
        {
        }

        public function exitForTest(string $mode): void
        {
            if ($mode === 'success') {
                $this->exitSuccess();
                return;
            }

            $this->exitFail('expected test failure');
        }

        protected function inConsole(): bool
        {
            return true;
        }
    };

    $Console->exitForTest($argv[2]);
    exit(99);
}
