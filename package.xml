<quiqqer>
    <package>
        <title>
            <locale group="quiqqer/frontend-users" var="package.title"/>
        </title>

        <description>
            <locale group="quiqqer/frontend-users" var="package.description"/>
        </description>

        <capabilities schemaVersion="1">
            <capability id="identity.frontend-user-registration">
                <title>Frontend user registration</title>
                <description>
                    Registers frontend users through configurable registrar providers, including e-mail registration, verification, activation, and optional REST access.
                </description>
            </capability>

            <capability id="authentication.frontend-user-login">
                <title>Frontend user login</title>
                <description>
                    Provides configurable frontend login pages and controls for the available QUIQQER authentication providers.
                </description>
            </capability>

            <capability id="identity.frontend-user-self-service">
                <title>Frontend user self-service</title>
                <description>
                    Lets frontend users manage their profile data, addresses, password, two-factor authentication, avatar, and account deletion.
                </description>
            </capability>

            <capability id="content.authenticated-audience-content">
                <title>Authenticated audience content</title>
                <description>
                    Displays tailored frontend content for guests, authenticated users, and members of selected user groups.
                </description>
            </capability>
        </capabilities>

        <image src="URL_OPT_DIR/quiqqer/frontend-users/bin/images/Logo.jpg"/>

        <preview>
            <image src="URL_OPT_DIR/quiqqer/frontend-users/bin/images/preview/Frontend_Registration.png"/>
            <image src="URL_OPT_DIR/quiqqer/frontend-users/bin/images/preview/Frontend_Login.png"/>
            <image src="URL_OPT_DIR/quiqqer/frontend-users/bin/images/preview/Frontend_Profile.png"/>
            <image src="URL_OPT_DIR/quiqqer/frontend-users/bin/images/preview/Backend_Settings.png"/>
        </preview>

        <support>
            <email><![CDATA[support@pcsg.de]]></email>
            <forum><![CDATA[https://community.quiqqer.com]]></forum>
            <source><![CDATA[https://dev.quiqqer.com/quiqqer/frontend-users]]></source>
            <issues><![CDATA[https://dev.quiqqer.com/quiqqer/frontend-users/issues]]></issues>
            <wiki><![CDATA[https://dev.quiqqer.com/quiqqer/frontend-users/wikis/home]]></wiki>
        </support>

        <languages>
            <language>de</language>
            <language>en</language>
        </languages>

        <copyright>
            <name><![CDATA[PCSG - Computer & Internet Service OHG]]></name>
            <license><![CDATA[GPL-3.0-or-later]]></license>
        </copyright>

        <provider>
            <erp src="\QUI\FrontendUsers\ErpProvider"/>
            <registrar src="\QUI\FrontendUsers\Registrars\Email\Registrar"/>
            <rest src="\QUI\FrontendUsers\Rest\Provider"/>
        </provider>
    </package>
</quiqqer>
